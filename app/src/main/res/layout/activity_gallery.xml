<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ix_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ix_bg"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/gallery_title"
        app:titleTextColor="@color/ix_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/cardFront"
                android:layout_width="match_parent"
                android:layout_height="176dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/imgFront"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/gallery_front"
                    android:padding="10dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/txtFrontPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/gallery_front_short"
                    android:textColor="@color/ix_muted"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnClearFront"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_chip"
                    android:contentDescription="@string/gallery_clear"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtFrontName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="middle"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/gallery_front"
                android:textColor="@color/ix_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/cardBack"
                android:layout_width="match_parent"
                android:layout_height="176dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/imgBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/gallery_back"
                    android:padding="10dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/txtBackPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/gallery_back_short"
                    android:textColor="@color/ix_muted"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnClearBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_chip"
                    android:contentDescription="@string/gallery_clear"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtBackName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="middle"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/gallery_back"
                android:textColor="@color/ix_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRecognize"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_accent"
            android:enabled="false"
            android:text="@string/gallery_recognize"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
